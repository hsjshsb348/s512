local function refreshRocketButtons()
	for _, child in ipairs(rocketList:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	local folder = workspace:FindFirstChild("Rockets")
	if not folder then return end

	local count = 0
	for _, child in ipairs(folder:GetChildren()) do
		if child:IsA("Model") then
			count += 1
			local button = Instance.new("TextButton")
			button.Size = UDim2.new(1, -8, 0, 36)
			button.Text = child.Name
			button.Font = Enum.Font.GothamBold
			button.TextSize = 14
			button.TextColor3 = Color3.new(1, 1, 1)
			button.BackgroundColor3 = (selectedRocket == child.Name) and Color3.fromRGB(0, 140, 220) or Color3.fromRGB(30, 42, 62)
			button.ZIndex = 7
			button.Parent = rocketList
			button.Activated:Connect(function()
				selectedRocket = child.Name
				refreshRocketButtons()
				triggerToast("SELECTED " .. child.Name)
			end)
		end
	end
	rocketList.CanvasSize = UDim2.fromOffset(0, count * 42)
end

task.spawn(function()
	while mapGui.Parent do
		if mapOpen then
			refreshRocketButtons()
		end
		task.wait(1.5)
	end
end)
