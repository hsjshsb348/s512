local function resetPointerState()
	dragging = false
	table.clear(touches)
	touchCount = 0
	gestureMultiTouch = false
	lastPinchDist = nil
end

task.spawn(function()
	local playerScripts = LocalPlayer:WaitForChild("PlayerScripts")
	local playerModule = playerScripts:WaitForChild("PlayerModule", 10)

	if not playerModule then return end

	local success, module = pcall(require, playerModule)
	if success and module then
		controls = module:GetControls()
		if mapOpen then
			controls:Disable()
			controlsDisabledByMap = true
		end
	end
end)

local function setMapControls(active)
	if not controls then return end
	if active then
		controls:Disable()
		controlsDisabledByMap = true
	elseif controlsDisabledByMap then
		controls:Enable()
		controlsDisabledByMap = false
	end
end

local function new(className, props, children)
	local instance = Instance.new(className)
	for key, value in pairs(props or {}) do
		instance[key] = value
	end
	for _, child in ipairs(children or {}) do
		child.Parent = instance
	end
	return instance
end

local function makeCorner(parent, radius)
	return new("UICorner", {
		CornerRadius = UDim.new(0, radius),
		Parent = parent,
	})
end

local function makeStroke(parent, color, thickness, transparency)
	return new("UIStroke", {
		Color = color or Color3.new(1, 1, 1),
		Thickness = thickness or 2,
		Transparency = transparency or 0,
		Parent = parent,
	})
end

