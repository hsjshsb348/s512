local function computeMapCFrame()
	local position = Vector3.new(
		camCenter.X,
		ISLAND_Y + camHeight,
		camCenter.Y
	)
	return CFrame.new(position) * CFrame.Angles(-math.pi / 2, 0, 0)
end

local function getStudsPerPixel()
	local viewportHeight = math.max(camera.ViewportSize.Y, 1)
	return (2 * math.tan(math.rad(camera.FieldOfView * 0.5)) * camHeight) / viewportHeight
end

local function panByPixels(delta)
	camCenter -= delta * getStudsPerPixel()
end

setMapHeight = function(height)
	camHeight = math.clamp(height, MIN_HEIGHT, MAX_HEIGHT)
	for _, entry in ipairs(zoomButtons) do
		local active = math.abs(entry.height - camHeight) < 1
		entry.button.BackgroundColor3 = active and COLOR_ACCENT or Color3.fromRGB(30, 42, 62)
		entry.button.TextColor3 = active and Color3.new(1, 1, 1) or Color3.fromRGB(200, 210, 225)
	end
end

-- يحول نقطة على الشاشة (إحداثيات الـ Viewport) إلى نقطة في العالم على ارتفاع ISLAND_Y
local function screenToWorld(screenPos)
	local ray = camera:ViewportPointToRay(screenPos.X, screenPos.Y)
	if math.abs(ray.Direction.Y) < 1e-4 then return nil end

	local t = (ISLAND_Y - ray.Origin.Y) / ray.Direction.Y
	if t <= 0 then return nil end

	return ray.Origin + ray.Direction * t
end

local function updateMarkerPositions()
	for _, marker in ipairs(markers) do
		local position = marker.posFn and marker.posFn()
		if position then
			local screenPoint, onScreen = camera:WorldToViewportPoint(position)
			marker.gui.Visible = onScreen
			if onScreen then
				marker.gui.Position = UDim2.fromOffset(screenPoint.X, screenPoint.Y)
			end
		else
			marker.gui.Visible = false
		end
	end
end

-- لو StreamingEnabled مفعّل: نطلب من السيرفر بث المنطقة اللي نشوفها في الخريطة
local function requestStreaming()
	if not workspace.StreamingEnabled then return end

	local target = Vector3.new(camCenter.X, ISLAND_Y, camCenter.Y)
	if lastStreamPos and (target - lastStreamPos).Magnitude < STREAM_REQUEST_DISTANCE then
		return
	end
	lastStreamPos = target

	task.spawn(function()
		pcall(function()
			LocalPlayer:RequestStreamAroundAsync(target)
		end)
	end)
end

local function cancelCameraTween()
	transitionVersion += 1
	if cameraTween then
		cameraTween:Cancel()
		cameraTween = nil
	end
end

openMap = function()
	if mapOpen or transitioning then return end
	camera = workspace.CurrentCamera
	if not camera then return end

	cancelCameraTween()

	savedCamType = camera.CameraType
	savedFieldOfView = camera.FieldOfView
	savedCamCFrame = camera.CFrame

	mapOpen = true
	transitioning = true
	resetPointerState()
	lastStreamPos = nil

	setMapControls(true)
	setMapHeight(ZOOM_PRESETS[1])

	camCenter = mapCenterDefault
	mapGui.Enabled = true

	entitySignature = ""
	refreshMarkers()

	toggleBtn.Text = "CLOSE"
	toggleBtn.BackgroundColor3 = Color3.fromRGB(150, 40, 40)

	camera.CameraType = Enum.CameraType.Scriptable
	camera.FieldOfView = 50

	local version = transitionVersion
	cameraTween = TweenService:Create(
		camera,
		TweenInfo.new(0.9, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
		{ CFrame = computeMapCFrame() }
	)

	cameraTween.Completed:Once(function(state)
		if version ~= transitionVersion then return end
		if state == Enum.PlaybackState.Completed then
			transitioning = false
			cameraTween = nil
		end
	end)

	cameraTween:Play()
end

closeMap = function()
	if not mapOpen then return end
	cancelCameraTween()

	mapOpen = false
	transitioning = true
	resetPointerState()

	toastVersion += 1
	if toastTween then
		toastTween:Cancel()
		toastTween = nil
	end

	toast.Visible = false
	mapGui.Enabled = false

	toggleBtn.Text = "MAP"
	toggleBtn.BackgroundColor3 = COLOR_PANEL

	local version = transitionVersion
	cameraTween = TweenService:Create(
		camera,
		TweenInfo.new(0.7, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
		{
			CFrame = savedCamCFrame,
			FieldOfView = savedFieldOfView,
		}
	)

	cameraTween.Completed:Once(function(state)
		if version ~= transitionVersion then return end
		if state == Enum.PlaybackState.Completed then
			camera.CameraType = savedCamType
			transitioning = false
			cameraTween = nil

			setMapControls(false)
			markerLayer:ClearAllChildren()
			markers = {}
			entitySignature = ""
		end
	end)

	cameraTween:Play()
end

toggleBtn.Activated:Connect(function()
	if mapOpen then
		closeMap()
	elseif not transitioning then
		openMap()
	end
end)

closeBtn.Activated:Connect(function()
	closeMap()
end)

----------------------------------------------------------------
-- الإدخال وإطلاق الصاروخ
----------------------------------------------------------------

local function isPanInput(input)
	return input.UserInputType == Enum.UserInputType.MouseButton2
		or input.UserInputType == Enum.UserInputType.MouseButton3
end

local function getRemote()
	if mapRemote and mapRemote.Parent then
		return mapRemote
	end

	local remote = ReplicatedStorage:FindFirstChild(REMOTE_NAME)
	if remote and remote:IsA("RemoteEvent") then
		mapRemote = remote
		return remote
	end

	return nil
end

-- screenPos بإحداثيات الـ Viewport (نفس إحداثيات GetMouseLocation)
local function launchRocketAt(screenPos)
	local remote = getRemote()
	if not remote then
		triggerToast("SERVER NOT READY")
		return
	end

	local now = os.clock()
	if now - lastFire < FIRE_COOLDOWN then
		triggerToast("RELOADING...")
		return
	end

	local target = screenToWorld(screenPos)
	if not target then return end

	lastFire = now
	remote:FireServer(target)
	triggerToast("ROCKET LAUNCHED TO TARGET!")
end

local function getPinchDistance()
	local first, second
	for _, data in pairs(touches) do
		if not first then
			first = data.pos
		else
			second = data.pos
			break
		end
	end

	if first and second then
		return (first - second).Magnitude
	end
	return nil
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if not mapOpen or transitioning then return end

	local inputType = input.UserInputType

	if inputType == Enum.UserInputType.MouseButton1 then
		dragStartPos = Vector2.new(input.Position.X, input.Position.Y)
		if not gameProcessed then
			dragging = true
		end

	elseif isPanInput(input) then
		dragStartPos = Vector2.new(input.Position.X, input.Position.Y)
		dragging = true

	elseif inputType == Enum.UserInputType.Touch then
		if gameProcessed then return end

		local pos = Vector2.new(input.Position.X, input.Position.Y)
		touches[input] = { start = pos, pos = pos }
		touchCount += 1

		if touchCount >= 2 then
			gestureMultiTouch = true
			lastPinchDist = getPinchDistance()
		end
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if not mapOpen or transitioning then return end

	local inputType = input.UserInputType

	if inputType == Enum.UserInputType.MouseMovement then
		if dragging then
			panByPixels(Vector2.new(input.Delta.X, input.Delta.Y))
		end

	elseif inputType == Enum.UserInputType.MouseWheel then
		setMapHeight(camHeight * (1 - input.Position.Z * 0.15))

	elseif inputType == Enum.UserInputType.Touch then
		local data = touches[input]
		if not data then return end

		local newPos = Vector2.new(input.Position.X, input.Position.Y)

		if touchCount == 1 then
			panByPixels(newPos - data.pos)
			data.pos = newPos
		else
			data.pos = newPos
			local dist = getPinchDistance()
			if dist and lastPinchDist and dist > 1 then
				setMapHeight(camHeight * (lastPinchDist / dist))
			end
			lastPinchDist = dist
		end
	end
end)

UserInputService.InputEnded:Connect(function(input, gameProcessed)
	local inputType = input.UserInputType

	-- اللمس: ننظف دائماً حتى لو الخريطة تغيّرت حالتها
	if inputType == Enum.UserInputType.Touch then
		local data = touches[input]
		if not data then return end

		touches[input] = nil
		touchCount = math.max(touchCount - 1, 0)
		lastPinchDist = nil

		local endPos = Vector2.new(input.Position.X, input.Position.Y)
		local wasTap = not gestureMultiTouch and (endPos - data.start).Magnitude < TAP_THRESHOLD

		if touchCount == 0 then
			gestureMultiTouch = false
		end

		if wasTap and not gameProcessed and mapOpen and not transitioning then
			-- input.Position لا يحسب الـ GuiInset، و ViewportPointToRay يحتاجه
			launchRocketAt(endPos + GuiService:GetGuiInset())
		end
		return
	end

	if not mapOpen or transitioning then return end

	if inputType == Enum.UserInputType.MouseButton1 then
		local endPos = Vector2.new(input.Position.X, input.Position.Y)
		local movedDist = (endPos - dragStartPos).Magnitude

		if not gameProcessed and movedDist < DRAG_THRESHOLD then
			launchRocketAt(UserInputService:GetMouseLocation())
		end
		dragging = false

	elseif isPanInput(input) then
		dragging = false
	end
end)

UserInputService.WindowFocusReleased:Connect(function()
	resetPointerState()
end)

local function updateKeyboardMovement(dt)
	if UserInputService:GetFocusedTextBox() then return end

	local movement = Vector2.zero
	if UserInputService:IsKeyDown(Enum.KeyCode.W) or UserInputService:IsKeyDown(Enum.KeyCode.Up) then
		movement += Vector2.new(0, -1)
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.S) or UserInputService:IsKeyDown(Enum.KeyCode.Down) then
		movement += Vector2.new(0, 1)
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.A) or UserInputService:IsKeyDown(Enum.KeyCode.Left) then
		movement += Vector2.new(-1, 0)
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.D) or UserInputService:IsKeyDown(Enum.KeyCode.Right) then
		movement += Vector2.new(1, 0)
	end

	if movement.Magnitude == 0 then return end

	local speed = camHeight * 0.8
	if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift) then
		speed *= 2
	end

	camCenter += movement.Unit * speed * dt
end

