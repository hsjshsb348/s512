RunService.RenderStepped:Connect(function(dt)
	if mapOpen then
		if not transitioning then
			updateKeyboardMovement(dt)
			camera.CFrame = computeMapCFrame()
		end
		updateMarkerPositions()
	end
end)

task.spawn(function()
	while mapGui.Parent do
		if mapOpen and not transitioning then
			refreshMarkers()
			requestStreaming()
		end
		task.wait(1)
	end
end)

LocalPlayer.CharacterAdded:Connect(function()
	if not mapOpen and not transitioning then return end

	cancelCameraTween()
	mapOpen = false
	transitioning = false
	resetPointerState()

	toastVersion += 1
	if toastTween then
		toastTween:Cancel()
		toastTween = nil
	end

	toast.Visible = false
	mapGui.Enabled = false

	markerLayer:ClearAllChildren()
	markers = {}
	entitySignature = ""

	toggleBtn.Text = "MAP"
	toggleBtn.BackgroundColor3 = COLOR_PANEL

	camera = workspace.CurrentCamera
	if camera then
		camera.FieldOfView = savedFieldOfView
		camera.CameraType = Enum.CameraType.Custom
	end

	setMapControls(false)
end)
