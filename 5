local function getHrpPosition(character)
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return root and root.Position or nil
end

local function makeMarker(config)
	-- Frame وليس TextButton: حتى لا تبتلع النقر وتمنع إطلاق الصاروخ
	local marker = new("Frame", {
		Name = config.name,
		BackgroundColor3 = config.color,
		BackgroundTransparency = config.transparency or 0,
		Size = UDim2.fromOffset(config.size, config.size),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Visible = false,
		ZIndex = 2,
		Parent = markerLayer,
	})

	new("UICorner", {
		CornerRadius = config.square
			and UDim.new(0, math.floor(config.size * 0.18))
			or UDim.new(1, 0),
		Parent = marker,
	})

	makeStroke(
		marker,
		config.strokeColor or Color3.new(1, 1, 1),
		config.strokeThickness or 2,
		0.2
	)

	if config.label then
		new("TextLabel", {
			Name = "Label",
			Text = config.label,
			Font = Enum.Font.Gotham,
			TextSize = 12,
			TextColor3 = Color3.fromRGB(225, 235, 245),
			BackgroundTransparency = 1,
			Size = UDim2.fromOffset(160, 18),
			Position = UDim2.new(0.5, 0, 1, 4),
			AnchorPoint = Vector2.new(0.5, 0),
			TextStrokeTransparency = 0.4,
			ZIndex = 3,
			Parent = marker,
		})
	end

	return {
		gui = marker,
		posFn = config.posFn,
	}
end

local function triggerToast(msg)
	toastVersion += 1
	local version = toastVersion

	if toastTween then
		toastTween:Cancel()
		toastTween = nil
	end

	toast.Text = string.upper(msg)
	toast.Visible = true
	toast.BackgroundTransparency = 0.1
	toast.TextTransparency = 0

	task.delay(1.5, function()
		if version ~= toastVersion then return end
		local fade = TweenService:Create(
			toast,
			TweenInfo.new(0.4),
			{ BackgroundTransparency = 1, TextTransparency = 1 }
		)
		toastTween = fade
		fade.Completed:Once(function()
			if version == toastVersion then
				toast.Visible = false
				toastTween = nil
			end
		end)
		fade:Play()
	end)
end

refreshMarkers = function()
	local entities = {}

	for _, player in ipairs(Players:GetPlayers()) do
		if player.Character then
			local isSelf = player == LocalPlayer
			local team = player.Team
			local isAlly = (not isSelf) and team ~= nil and team == LocalPlayer.Team

			local relation = "enemy"
			local color = COLOR_OTHER
			if isSelf then
				relation = "self"
				color = COLOR_SELF
			elseif isAlly then
				relation = "ally"
				color = COLOR_ALLY
			end

			table.insert(entities, {
				key = "player:" .. player.Name .. ":" .. relation,
				config = {
					name = "Player_" .. player.Name,
					size = 16,
					color = color,
					label = player.DisplayName,
					posFn = function()
						return getHrpPosition(player.Character)
					end,
				},
			})
		end
	end

	table.sort(entities, function(a, b)
		return a.key < b.key
	end)

	local signatureParts = {}
	for _, entity in ipairs(entities) do
		table.insert(signatureParts, entity.key .. ":" .. (entity.config.label or ""))
	end

	local signature = table.concat(signatureParts, "|")
	if signature == entitySignature then return end

	entitySignature = signature
	markerLayer:ClearAllChildren()
	markers = {}

	for _, entity in ipairs(entities) do
		table.insert(markers, makeMarker(entity.config))
	end
end

