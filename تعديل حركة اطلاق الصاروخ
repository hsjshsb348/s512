local RunService = game:GetService("RunService")

-- ===== SETTINGS =====
local START_DELAY = 2                          -- seconds before launch
local DURATION = 6                             -- flight time (seconds)
local TARGET_OFFSET = Vector3.new(0, 0, -150)  -- landing spot, relative to start
local HEIGHT = 120                             -- how high the path bends
local DESTROY_AT_END = false
local NOSE_AXIS = Vector3.new(0, 0, -1)        -- nose direction in pivot space
-- ====================

local model = script.Parent
if not model:IsA("Model") then
	warn("Put this Script directly inside the rocket Model")
	return
end

for _, d in ipairs(model:GetDescendants()) do
	if d:IsA("BasePart") then d.Anchored = true end
end

local startCF = model:GetPivot()
local startLook = startCF:VectorToWorldSpace(NOSE_AXIS).Unit
local startRot = startCF.Rotation

local P0 = startCF.Position
local P3 = P0 + TARGET_OFFSET
local P1 = P0 + Vector3.new(0, HEIGHT, 0)
local P2 = P3 + Vector3.new(0, HEIGHT, 0)

local function point(t)
	local u = 1 - t
	return u*u*u*P0 + 3*u*u*t*P1 + 3*u*t*t*P2 + t*t*t*P3
end

local function tangent(t)
	local u = 1 - t
	return 3*u*u*(P1-P0) + 6*u*t*(P2-P1) + 3*t*t*(P3-P2)
end

local function rotateTo(a, b)
	local dot = math.clamp(a:Dot(b), -1, 1)
	if dot > 0.99999 then return CFrame.identity end
	local axis = a:Cross(b)
	if axis.Magnitude < 1e-5 then
		axis = a:Cross(Vector3.xAxis)
		if axis.Magnitude < 1e-5 then axis = a:Cross(Vector3.zAxis) end
	end
	return CFrame.fromAxisAngle(axis.Unit, math.acos(dot))
end

task.wait(START_DELAY)
local t0 = os.clock()
local lastDir = startLook
local conn
conn = RunService.Heartbeat:Connect(function()
	local t = math.min((os.clock() - t0) / DURATION, 1)
	local dir = tangent(t)
	if dir.Magnitude > 0.001 then lastDir = dir.Unit end
	model:PivotTo(CFrame.new(point(t)) * rotateTo(startLook, lastDir) * startRot)
	if t >= 1 then
		conn:Disconnect()
		if DESTROY_AT_END then model:Destroy() end
	end
end)
