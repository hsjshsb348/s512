UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		if mapOpen and not transitioning and dragDist < DRAG_THRESHOLD then
			-- حساب الإحداثيات في الماب بناءً على مكان الماوس على الشاشة
			local mouseLocation = UserInputService:GetMouseLocation() - camera.ViewportSize / 2
			local viewportHeight = math.max(camera.ViewportSize.Y, 1)
			
			local studsPerPixel = (2 * math.tan(math.rad(camera.FieldOfView * 0.5)) * camHeight) / viewportHeight
			
			-- تحويل شاشة الماوس إلى إحداثيات Vector3 في العالم الحقيقي
			local targetWorldPos = Vector3.new(
				camCenter.X + mouseLocation.X * studsPerPixel,
				ISLAND_Y,
				camCenter.Y + mouseLocation.Y * studsPerPixel
			)
			
			-- البحث عن الحدث وإرسال الإحداثيات للسيرفر بشكل آمن ومضمون
			local remote = ReplicatedStorage:FindFirstChild("MapTargetSelected")
			if remote then
				remote:FireServer(targetWorldPos)
				print("📤 تم إرسال الإحداثيات إلى السيرفر بنجاح:", targetWorldPos)
			else
				warn("⚠️ خطأ: لم يتم العثور على RemoteEvent باسم MapTargetSelected في ReplicatedStorage!")
			end
			
			statusLabel.Text = "TARGET POSITION LOCKED!"
		end
		
		dragging = false
		
	elseif isPanInput(input) then
		dragging = false
	end
end)
