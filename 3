local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

-- المتغيرات الأساسية للتحكم بالخريطة
local mapOpen = true
local transitioning = false
local dragging = false
local dragDist = 0
local DRAG_THRESHOLD = 10
local ISLAND_Y = 0 
local camCenter = Vector2.new(0, 0)
local camHeight = 100

-- البحث عن خانة عرض الحالة (StatusLabel) إن وجدت
local playerGui = player:WaitForChild("PlayerGui")
local statusLabel = nil
-- (يمكنك تركها هكذا ولن تحدث أي أخطاء حتى لو لم تكن موجودة)

local function isPanInput(input)
	return input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton2
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if not mapOpen or transitioning then
		return
	end

	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragDist = 0
		dragging = true
	elseif isPanInput(input) then
		dragDist = 0
		dragging = true
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		if mapOpen and not transitioning and dragDist < DRAG_THRESHOLD then
			-- حساب الإحداثيات في الخريطة بناءً على مكان الماوس على الشاشة
			local mouseLocation = UserInputService:GetMouseLocation() - camera.ViewportSize / 2
			local viewportHeight = math.max(camera.ViewportSize.Y, 1)
			
			local studsPerPixel = (2 * math.tan(math.rad(camera.FieldOfView * 0.5)) * camHeight) / viewportHeight
			
			-- تحويل شاشة الماوس إلى إحداثيات Vector3 في العالم الحقيقي
			local targetWorldPos = Vector3.new(
				camCenter.X + mouseLocation.X * studsPerPixel,
				ISLAND_Y,
				camCenter.Y + mouseLocation.Y * studsPerPixel
			)
			
			-- إرسال الإحداثيات للسيرفر بشكل آمن ومضمون
			local remote = ReplicatedStorage:FindFirstChild("MapTargetSelected")
			if remote then
				remote:FireServer(targetWorldPos)
				print("📤 تم إرسال الإحداثيات إلى السيرفر بنجاح:", targetWorldPos)
			else
				warn("⚠️ خطأ: لم يتم العثور على RemoteEvent باسم MapTargetSelected في ReplicatedStorage!")
			end
			
			if statusLabel then
				statusLabel.Text = "TARGET POSITION LOCKED!"
			end
		end
		
		dragging = false
	elseif isPanInput(input) then
		dragging = false
	end
end)
